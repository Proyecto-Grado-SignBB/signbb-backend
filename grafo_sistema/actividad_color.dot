digraph GrafoActividadColaPrioridad {
// Configuraciones globales para aumentar el espaciado
graph [ranksep=1.5, nodesep=1.2];
node [fontname="Helvetica", style=filled, fillcolor=white, margin=0.2];
// minlen fuerza a que la arista sea más larga
edge [fontname="Helvetica", fontsize=11, minlen=2];

// NODO RAÍZ DEL SUBGRAFO (Selección múltiple, color azul)
q_multi_prioridad [label="¿Qué cambios nota en su bebé?", color=blue, fontcolor=blue];

// NODOS DE TERMINACIÓN (Destinos finales de las ramas)
T_URGENCIA [label="URGENCIA\n(Corta la ejecución de la cola y arroja resultado)", shape=doublecircle, color=red, fontcolor=red];
T_CONSULTA [label="CONSULTAR_MEDICO\n(Almacena estado y continúa con la siguiente rama en cola)", shape=doublecircle, color=yellow, fontcolor=darkgoldenrod];
T_NORMAL [label="NORMAL\n(Desarta rama y evalúa la siguiente opción en la cola)", shape=doublecircle, color=green, fontcolor=darkgreen];

// ==========================================
// RAMA 1: TONO MUSCULAR Y MOVIMIENTO (Peso 3)
// ==========================================
q_intermedia_tono [label="¿Nota que el bebé está anormalmente flojo o rígido?", color=black];
q_tono_extremo [label="¿Está completamente flácido (como muñeca de trapo), rígido, o tiene movimientos repetitivos que no paran?", color=black];
q_tono_estimulo [label="Al estimularlo o intentar despertarlo, ¿reacciona y se mueve con normalidad?", color=black];

// ==========================================
// RAMA 2: COLORACIÓN (Peso 2)
// ==========================================
q_intermedia_color [label="¿En qué zonas del cuerpo observa el color anormal?", color=black];
q_color_ictericia_cara [label="El color amarillo, ¿llega por debajo del ombligo, a las piernas, o a las plantas de los pies?", color=black];
q_color_cianosis [label="Tiene las manos/pies azules, pero ¿los labios y la lengua de su bebé también están azules o grises?", color=black];

// ==========================================
// RAMA 3: LLANTO E IRRITABILIDAD (Peso 1)
// ==========================================
q_intermedia_llanto [label="¿El llanto de su bebé es inconsolable?", color=black];
q_llanto_calma [label="¿Logra calmarse después de intentar alimentarlo, cargarlo o cambiarlo como hace habitualmente?", color=black];
q_llanto_comun [label="¿El bebé está más inquieto o molesto de lo normal, pero logra tranquilizarse eventualmente?", color=black];

// CONEXIONES HACIA LAS RAMAS DESDE LA SELECCIÓN MÚLTIPLE
// Se agregan saltos de línea (\n) y espacios alrededor del texto de la etiqueta
q_multi_prioridad -> q_intermedia_tono [label="\n   Opción: Problemas de tono/actividad (Peso 3)   \n"];
q_multi_prioridad -> q_intermedia_color [label="\n   Opción: Cambios de color en la piel (Peso 2)   \n"];
q_multi_prioridad -> q_intermedia_llanto [label="\n   Opción: Llanto inusual/irritabilidad (Peso 1)   \n"];

// FLUJO RAMA 1: TONO MUSCULAR Y MOVIMIENTO
q_intermedia_tono -> q_tono_extremo [label="\n   Sí, lo noto distinto   \n"];
q_intermedia_tono -> q_tono_estimulo [label="\n   No estoy seguro, solo está muy dormido   \n"];

q_tono_extremo -> T_URGENCIA [label="\n   Sí, muy flácido/rígido/movimientos raros   \n"];
q_tono_extremo -> T_CONSULTA [label="\n   No llega a esos extremos, pero está raro   \n"];

q_tono_estimulo -> T_NORMAL [label="\n   Sí, reacciona y se mueve normal   \n"];
q_tono_estimulo -> T_CONSULTA [label="\n   No, cuesta mucho despertarlo   \n"];

// FLUJO RAMA 2: COLORACIÓN
q_intermedia_color -> q_color_ictericia_cara [label="\n   Lo veo color amarillo   \n"];
q_intermedia_color -> q_color_cianosis [label="\n   Lo veo color azulado o morado   \n"];

q_color_ictericia_cara -> T_URGENCIA [label="\n   Sí, llega debajo del ombligo o plantas   \n"];
q_color_ictericia_cara -> T_CONSULTA [label="\n   No, solo está en ojos, cara o pecho   \n"];

q_color_cianosis -> T_URGENCIA [label="\n   Sí, labios/lengua azules   \n"];
q_color_cianosis -> T_NORMAL [label="\n   No, labios rosados (solo manos/pies azules)   \n"];

// FLUJO RAMA 3: LLANTO E IRRITABILIDAD
q_intermedia_llanto -> q_llanto_calma [label="\n   Sí, llora mucho   \n"];
q_intermedia_llanto -> q_llanto_comun [label="\n   No es inconsolable, solo molesto   \n"];

q_llanto_calma -> T_CONSULTA [label="\n   Sí, finalmente se calma   \n"];
q_llanto_calma -> T_URGENCIA [label="\n   No, no para de llorar con nada   \n"];

q_llanto_comun -> T_CONSULTA [label="\n   Sí, más irritable pero se calma   \n"];
q_llanto_comun -> T_NORMAL [label="\n   Llora por lo normal (hambre/sueño) y se calma rápido   \n"];
}
