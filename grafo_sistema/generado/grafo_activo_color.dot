digraph grafo_activo_color {
// Generado desde grafo_activo_color.json — Evaluación Actividad y Color
// Configuración general
graph [ranksep=1.5, nodesep=1.2];
node [fontname="Helvetica", style=filled, fillcolor=white, margin=0.2];
edge [fontname="Helvetica", fontsize=11, minlen=2];

// NODOS
q_multi_prioridad [label="Seleccione anomalías observadas", color=blue, fontcolor=blue];
q_intermedia_tono [label="¿El bebé está flojo o rígido?", color=black];
q_tono_extremo [label="¿Está flácido, rígido o con movimientos raros?", color=black];
q_tono_estimulo [label="Al estimularlo, ¿reacciona normal?", color=black];
q_intermedia_color [label="¿Coloración anormal?", color=black];
q_color_ictericia_cara [label="¿Amarillo llega debajo de ombligo/plantas?", color=black];
q_color_cianosis [label="¿Labios/lengua azules?", color=black];
q_intermedia_llanto [label="¿Llanto inconsolable?", color=black];
q_llanto_calma [label="¿Logra calmarse eventualmente?", color=black];
q_llanto_comun [label="¿Llora más pero se calma?", color=black];
urgencia_1 [label="URGENCIA", shape=doublecircle, color=red, fontcolor=red];
consulta_1 [label="CONSULTA", shape=doublecircle, color=yellow, fontcolor=darkgoldenrod];
normal_1 [label="NORMAL", shape=doublecircle, color=green, fontcolor=darkgreen];

// ARISTAS
q_multi_prioridad -> q_intermedia_tono [label="\n   tono   \n"];
q_multi_prioridad -> q_intermedia_color [label="\n   color   \n"];
q_multi_prioridad -> q_intermedia_llanto [label="\n   llanto   \n"];
q_intermedia_tono -> q_tono_extremo [label="\n   SI   \n"];
q_intermedia_tono -> q_tono_estimulo [label="\n   NO   \n"];
q_tono_extremo -> urgencia_1 [label="\n   SI   \n"];
q_tono_extremo -> consulta_1 [label="\n   NO   \n"];
q_tono_estimulo -> normal_1 [label="\n   SI   \n"];
q_tono_estimulo -> consulta_1 [label="\n   NO   \n"];
q_intermedia_color -> q_color_ictericia_cara [label="\n   AMARILLO   \n"];
q_intermedia_color -> q_color_cianosis [label="\n   AZUL   \n"];
q_color_ictericia_cara -> urgencia_1 [label="\n   SI   \n"];
q_color_ictericia_cara -> consulta_1 [label="\n   NO   \n"];
q_color_cianosis -> urgencia_1 [label="\n   SI   \n"];
q_color_cianosis -> normal_1 [label="\n   NO   \n"];
q_intermedia_llanto -> q_llanto_calma [label="\n   SI   \n"];
q_intermedia_llanto -> q_llanto_comun [label="\n   NO   \n"];
q_llanto_calma -> consulta_1 [label="\n   SI   \n"];
q_llanto_calma -> urgencia_1 [label="\n   NO   \n"];
q_llanto_comun -> consulta_1 [label="\n   SI   \n"];
q_llanto_comun -> normal_1 [label="\n   NO   \n"];
}
