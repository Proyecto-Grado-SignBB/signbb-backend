digraph grafo_raiz {
// Generado desde grafo_raiz.json — Grafo raíz de SignBB
// Configuración general
node [fontname="Helvetica", style=filled, fillcolor=white];
edge [fontname="Helvetica", fontsize=10];

// NODOS
pregunta_inicial [label="¿Sientes que tu bebé está diferente a como normalmente es?\nSeleccione las categorías a consultar", color=blue, fontcolor=blue];
puente_respiracion [label="¿Qué anomalía principal observa en la respiración o nariz?", color=black];
puente_gastro [label="¿Qué anomalía observa en la alimentación, vómito, abdomen o deposiciones?", color=black];
puente_neuro [label="¿Qué anomalía observa en la actividad, color, piel, temperatura o sentidos?", color=black];
ref_grafo_respiracion [label="Grafo de Respiración y Nariz", color=purple, fontcolor=purple];
ref_grafo_gastro [label="Grafo Gastrointestinal", color=purple, fontcolor=purple];
ref_grafo_neuro [label="Grafo Neurológico y Color", color=purple, fontcolor=purple];

// ARISTAS
pregunta_inicial -> puente_respiracion [label="\n   respiracion   \n"];
pregunta_inicial -> puente_gastro [label="\n   gastrointestinal   \n"];
pregunta_inicial -> puente_neuro [label="\n   neurologico   \n"];
puente_respiracion -> ref_grafo_respiracion [label="\n   iniciar   \n"];
puente_gastro -> ref_grafo_gastro [label="\n   iniciar   \n"];
puente_neuro -> ref_grafo_neuro [label="\n   iniciar   \n"];
}
