digraph GrafoRespiracion {
// Configuración general
node [fontname="Helvetica", style=filled, fillcolor=white];
edge [fontname="Helvetica", fontsize=10];

// PREGUNTAS DE SELECCIÓN MÚLTIPLE (Rama secuencial, color azul)
q_resp_urgencia [label="¿Observa alguno de estos signos de alarma?", color=blue];
q_resp_consulta [label="¿Presenta alguno de estos signos de alerta media?", color=blue];
q_resp_normal [label="¿Presenta alguna de estas condiciones comunes?", color=blue];

// NODOS DE TERMINACIÓN (Severidad)
T_URGENCIA [label="URGENCIA\nLleva a tu bebé a urgencias ahora.", shape=doublecircle, color=red, fontcolor=red];
T_CONSULTA [label="CONSULTAR_MEDICO\nContacta hoy al Programa Madre Canguro.", shape=doublecircle, color=yellow, fontcolor=darkgoldenrod];
T_NORMAL [label="NORMAL\nLo que observas puede ser normal. Sigue observando.", shape=doublecircle, color=green, fontcolor=darkgreen];

  // CONEXIONES URGENCIA
  q_resp_urgencia -> T_URGENCIA [label="Respira persistentemente rápido (≥60/min)"];
  q_resp_urgencia -> T_URGENCIA [label="Quejido al respirar"];
  q_resp_urgencia -> T_URGENCIA [label="Aleteo nasal"];
  q_resp_urgencia -> T_URGENCIA [label="Se le hunde el pecho"];
  q_resp_urgencia -> T_URGENCIA [label="Pausas o Apneas con cambio de color"];
  q_resp_urgencia -> T_URGENCIA [label="Labios o cara azules/grises"];
  // Ruta de caída
  q_resp_urgencia -> q_resp_consulta [label="No, ninguno de los anteriores"];

  // CONEXIONES CONSULTA
  q_resp_consulta -> T_CONSULTA [label="Congestión que dificulta alimentarse"];
  q_resp_consulta -> T_CONSULTA [label="Ruido al respirar que antes no hacía"];
  q_resp_consulta -> T_CONSULTA [label="Respira diferente sin esfuerzo"];
  q_resp_consulta -> T_CONSULTA [label="Presenta tos pero respira tranquilo"];
  // Ruta de caída
  q_resp_consulta -> q_resp_normal [label="No, ninguno de los anteriores"];

  // CONEXIONES NORMAL
  q_resp_normal -> T_NORMAL [label="Pausas cortas sin cambiar de color"];
  q_resp_normal -> T_NORMAL [label="Ruiditos pero respira tranquilo"];
  q_resp_normal -> T_NORMAL [label="Estornudos o hipo"];
  q_resp_normal -> T_NORMAL [label="Congestión nasal leve"];
  // Ruta de caída final
  q_resp_normal -> T_NORMAL [label="No, no presenta anomalías"];
}
