@startuml
allowmixing
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60

title SignBB Backend — Arquitectura por módulos

package "observaciones" {
  package "controladores" as obs_ctrl {
    class ControladorConsulta
    class "RecorridoDTO / PreguntaDTO / ResultadoDTO\nPasoCausalDTO / RespuestaRequest" as DTOs
  }
  package "modelo" as obs_mod {
    class SeleccionCuidador
    class TipoInteraccion
  }
  package "datos" {
    package "entidades" as obs_ent {
      class ObservacionEntity
    }
    package "repositorios" as obs_repo {
      class RepositorioObservaciones
    }
  }
  package "servicios" as obs_srv {
    class "ServicioCaptura (Impl)" as ServicioCaptura
  }
}

package "navegacion" {
  package "datos" {
    package "serializacion" as nav_ser {
      class GrafoClinicoParser
    }
    package "repositorios (reservado)" as nav_repo
    package "entidades (reservado)" as nav_ent
  }
  package "modelo (TAD)" as nav_mod {
    class GrafoClinico
    class Nodo
    class EstadoPaciente
    class SesionTriaje
    class RepositorioSesion
    class ContextoClinico
  }
  package "servicios" as nav_srv {
    class "ServicioNavegacion (Impl)" as ServicioNavegacion
    class MotorNavegacion
  }
}

package "reglas" {
  package "datos" {
    package "serializacion" as reg_ser {
      class BaseReglasParser
    }
    package "repositorios (reservado)" as reg_repo
    package "entidades (reservado)" as reg_ent
  }
  package "modelo (TAD)" as reg_mod {
    class BaseReglas
    class ReglaClinica
    class NivelAlerta
  }
  package "servicios" as reg_srv {
    class "ServicioReglas (Impl)" as ServicioReglas
  }
}

package "auditoria (reservado)" as auditoria {
  package "datos (reservado)" as aud_datos
  package "modelo (reservado)" as aud_mod
  package "servicios (reservado)" as aud_srv
  package "controladores (reservado)" as aud_ctrl
}
package "seguridad (reservado)" as seguridad

package "config" {
  class ConfiguracionCors
  class ManejadorExcepciones
  class RecursoNoEncontradoException
}

class "DemoTriajeRunner" as demo

database "H2 (en memoria)" as h2

' Flujo de una consulta guiada (captura de observaciones)
obs_ctrl ..> obs_srv : registrar respuesta\n(valida y audita)
obs_ctrl ..> nav_srv : iniciar / consultar
obs_srv ..> nav_srv : responder(List<String>)
obs_srv ..> obs_repo : persiste la selección
obs_repo ..> obs_ent
obs_repo ..> h2

' Núcleo de navegación y reglas
nav_srv ..> nav_mod : grafo, sesiones y estado
nav_srv ..> reg_srv : forward chaining
nav_srv ..> reg_mod : BaseReglas, NivelAlerta
nav_srv ..> obs_ctrl : consume RecorridoDTO / PreguntaDTO

' Carga inicial desde los JSON del classpath
nav_mod ..> nav_ser : ContextoClinico carga el grafo
nav_mod ..> reg_ser : ContextoClinico carga la base de reglas
reg_ser ..> nav_mod : resuelve nodoDestino\ncontra el grafo
reg_ser ..> reg_mod : construye ReglaClinica

' Demo de arranque por consola
demo ..> nav_mod : grafo de ejemplo
demo ..> reg_srv : evalúa escenarios

note bottom of reg_ser
  Dependencias cruzadas conocidas (refactor pendiente):
  ContextoClinico vive en navegación pero carga la base de
  reglas; BaseReglasParser resuelve destinos contra el grafo
  de navegación; los DTO del recorrido viven en
  observaciones.controladores y navegación los consume.
end note

note right of auditoria
  Paquetes reservados, sin implementación aún.
end note
@enduml
