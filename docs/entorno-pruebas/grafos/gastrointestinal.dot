digraph grafo_gastro {
// Generado desde la definición de grafo_sistema
graph [ranksep=1.4, nodesep=1.0];
node [fontname="Helvetica", style=filled, fillcolor=white, margin=0.2];
edge [fontname="Helvetica", fontsize=10];

// ENTRADA
q_gastro_gate [label="¿Nota algo distinto en su alimentación o digestión?", color=black];

// SUBÁREAS
q_gastro_areas [label="Marca todo lo que quieras revisar.", color=blue, fontcolor=blue];
q_gastro_vomito [label="Marca todo lo que notes sobre el vómito.", color=blue, fontcolor=blue];
q_gastro_alimentacion [label="Marca todo lo que notes al alimentarlo.", color=blue, fontcolor=blue];
q_gastro_abdomen [label="Marca todo lo que notes en su barriga.", color=blue, fontcolor=blue];
q_gastro_popo [label="Marca todo lo que notes en su popó.", color=blue, fontcolor=blue];
q_gastro_orina [label="Marca todo lo que notes en su orina.", color=blue, fontcolor=blue];

// TERMINALES
T_URGENCIA [label="URGENCIA\nLleva a tu bebé a urgencias ahora.", shape=doublecircle, color=red, fontcolor=red];
T_CONSULTA [label="CONSULTAR_MEDICO\nContacta hoy al Programa Madre Canguro.", shape=doublecircle, color=yellow, fontcolor=darkgoldenrod];
T_NORMAL [label="NORMAL\nLo que observas puede ser normal. Sigue observando.", shape=doublecircle, color=green, fontcolor=darkgreen];

// ENTRADA
q_gastro_gate -> q_gastro_areas [label="Sí"];
q_gastro_gate -> T_NORMAL [label="No"];

// SUBÁREAS
q_gastro_areas -> q_gastro_vomito [label="Vómito (3)"];
q_gastro_areas -> q_gastro_alimentacion [label="Alimentación (3)"];
q_gastro_areas -> q_gastro_abdomen [label="Barriga (3)"];
q_gastro_areas -> q_gastro_popo [label="Popó (3)"];
q_gastro_areas -> q_gastro_orina [label="Orina (3)"];

// VÓMITO
q_gastro_vomito -> T_URGENCIA [label="Vomita todo lo que ingiere (3)"];
q_gastro_vomito -> T_URGENCIA [label="Vomita con fuerza/sale disparado (3)"];
q_gastro_vomito -> T_CONSULTA [label="Ha vomitado varias veces (2)"];
q_gastro_vomito -> T_NORMAL [label="Vomita una sola vez y después bien (1)"];
q_gastro_vomito -> T_NORMAL [label="Regurgitador feliz (1)"];

// ALIMENTACIÓN
q_gastro_alimentacion -> T_URGENCIA [label="No logra alimentarse o rechaza pecho (3)"];
q_gastro_alimentacion -> T_URGENCIA [label="Tose, atraganta, deja de respirar o cambia color al comer (3)"];
q_gastro_alimentacion -> T_CONSULTA [label="Come mucho menos o succiona débil (2)"];
q_gastro_alimentacion -> T_CONSULTA [label="Se queda dormido repetidamente al comer (2)"];
q_gastro_alimentacion -> T_CONSULTA [label="Tarda mucho más de lo habitual (2)"];
q_gastro_alimentacion -> T_NORMAL [label="Se alimenta como siempre (1)"];

// ABDOMEN
q_gastro_abdomen -> T_URGENCIA [label="Barriga muy hinchada y dura/tensa (3)"];
q_gastro_abdomen -> T_URGENCIA [label="Barriga hinchada + vómito o sangre en popó (3)"];
q_gastro_abdomen -> T_URGENCIA [label="Barriga hinchada + no quiere comer o está decaído (3)"];
q_gastro_abdomen -> T_CONSULTA [label="Barriga más hinchada, pero blanda y come bien (2)"];
q_gastro_abdomen -> T_NORMAL [label="Barriga redondita después de comer, blanda (1)"];

// DEPOSICIONES
q_gastro_popo -> T_URGENCIA [label="Popó blanco o gris claro (3)"];
q_gastro_popo -> T_URGENCIA [label="Sangre roja en popó (3)"];
q_gastro_popo -> T_URGENCIA [label="No hace popó + barriga hinchada o vómito (3)"];
q_gastro_popo -> T_CONSULTA [label="Cambió frecuencia o consistencia (2)"];
q_gastro_popo -> T_CONSULTA [label="Mucho moco repetido (2)"];
q_gastro_popo -> T_CONSULTA [label="Muchas más o menos deposiciones (2)"];
q_gastro_popo -> T_CONSULTA [label="Deposiciones más líquidas de lo habitual (2)"];
q_gastro_popo -> T_NORMAL [label="Popó amarillo, verde, café o mostaza (1)"];
q_gastro_popo -> T_NORMAL [label="Aguado o con grumitos, bebé bien (1)"];
q_gastro_popo -> T_NORMAL [label="Hace fuerza/puja y popó blando (1)"];
q_gastro_popo -> T_NORMAL [label="Popó negro en los primeros 3 días (1)"];
q_gastro_popo -> T_NORMAL [label="Pasa días sin popó, pero come bien y barriga blanda (1)"];

// ORINA
q_gastro_orina -> T_URGENCIA [label="Sangre roja en orina/pañal (3)"];
q_gastro_orina -> T_URGENCIA [label="Muchas horas sin mojar ningún pañal (3)"];
q_gastro_orina -> T_CONSULTA [label="Mojando menos pañales (2)"];
q_gastro_orina -> T_CONSULTA [label="Olor diferente o fuerte persistente (2)"];
q_gastro_orina -> T_CONSULTA [label="Llora/molesta al orinar (2)"];
q_gastro_orina -> T_NORMAL [label="Moja pañales habitual / amarilla clara (1)"];
q_gastro_orina -> T_NORMAL [label="Mancha rosada/naranja en los primeros días (1)"];

}
