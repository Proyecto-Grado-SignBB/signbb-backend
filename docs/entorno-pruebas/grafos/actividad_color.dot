digraph grafo_activo_color {
// Generado desde la definición de grafo_sistema
graph [ranksep=1.4, nodesep=1.0];
node [fontname="Helvetica", style=filled, fillcolor=white, margin=0.2];
edge [fontname="Helvetica", fontsize=10];

// ENTRADA
q_neuro_gate [label="¿Nota cambios en la actividad, el llanto o el color de su bebé?", color=black];

// SUBÁREAS
q_neuro_areas [label="Marca todo lo que quieras revisar.", color=blue, fontcolor=blue];
q_neuro_tono [label="Marca todo lo que notes en su movimiento o tono.", color=blue, fontcolor=blue];
q_neuro_llanto [label="Marca todo lo que notes en su llanto.", color=blue, fontcolor=blue];
q_neuro_color [label="Marca todo lo que notes en su color.", color=blue, fontcolor=blue];

// TERMINALES
T_URGENCIA [label="URGENCIA\nLleva a tu bebé a urgencias ahora.", shape=doublecircle, color=red, fontcolor=red];
T_CONSULTA [label="CONSULTAR_MEDICO\nContacta hoy al Programa Madre Canguro.", shape=doublecircle, color=yellow, fontcolor=darkgoldenrod];
T_NORMAL [label="NORMAL\nLo que observas puede ser normal. Sigue observando.", shape=doublecircle, color=green, fontcolor=darkgreen];

// ENTRADA
q_neuro_gate -> q_neuro_areas [label="Sí"];
q_neuro_gate -> T_NORMAL [label="No"];

// SUBÁREAS
q_neuro_areas -> q_neuro_tono [label="Movimiento y tono (3)"];
q_neuro_areas -> q_neuro_llanto [label="Llanto e irritabilidad (3)"];
q_neuro_areas -> q_neuro_color [label="Color de piel y ojos (3)"];

// MOVIMIENTO Y TONO
q_neuro_tono -> T_URGENCIA [label="Mucho más dormido / cuesta despertarlo (3)"];
q_neuro_tono -> T_URGENCIA [label="Más flojito de lo habitual (3)"];
q_neuro_tono -> T_URGENCIA [label="Más tieso de lo habitual / cuerpo rígido (3)"];
q_neuro_tono -> T_URGENCIA [label="Movimientos anormales o repetitivos (3)"];
q_neuro_tono -> T_NORMAL [label="Duerme bastante, pero despierta para comer y activo (1)"];
q_neuro_tono -> T_NORMAL [label="Sobresaltos mientras duerme y luego normal (1)"];

// LLANTO E IRRITABILIDAD
q_neuro_llanto -> T_CONSULTA [label="Más irritable/llora más, pero calma (2)"];
q_neuro_llanto -> T_URGENCIA [label="Llanto inconsolable (3)"];

// COLOR (ICTERICIA)
q_neuro_color -> T_NORMAL [label="Solo blanco de ojos amarillo, comiendo y comportándose bien (1)"];
q_neuro_color -> T_CONSULTA [label="Color amarillo en ojos, cara o hasta pecho (2)"];
q_neuro_color -> T_URGENCIA [label="Amarillo por debajo del ombligo o piernas (3)"];
q_neuro_color -> T_URGENCIA [label="Palmas de manos o plantas amarillas (3)"];
q_neuro_color -> T_URGENCIA [label="Amarillo + muy dormido/no come (3)"];
q_neuro_color -> T_URGENCIA [label="Amarillo en primeras 24 horas (3)"];

}
