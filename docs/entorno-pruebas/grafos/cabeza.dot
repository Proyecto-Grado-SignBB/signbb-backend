digraph grafo_cabeza {
// Generado desde la definición de grafo_sistema
graph [ranksep=1.4, nodesep=1.0];
node [fontname="Helvetica", style=filled, fillcolor=white, margin=0.2];
edge [fontname="Helvetica", fontsize=10];

// ENTRADA
q_cab_gate_fontanela [label="¿La mollera (fontanela) se ve abultada o hinchada cuando el bebé está tranquilo?", color=black];
q_cab_gate_ojos [label="¿Notas algo en sus ojos?", color=black];
q_cab_gate_oidos [label="¿Notas algo en sus oídos?", color=black];

// SELECCIÓN MÚLTIPLE
q_cab_ojos [label="Marca todo lo que veas.", color=blue, fontcolor=blue];
q_cab_oidos [label="Marca todo lo que notes.", color=blue, fontcolor=blue];

// TERMINALES
T_URGENCIA [label="URGENCIA\nLleva a tu bebé a urgencias ahora.", shape=doublecircle, color=red, fontcolor=red];
T_CONSULTA [label="CONSULTAR_MEDICO\nContacta hoy al Programa Madre Canguro.", shape=doublecircle, color=yellow, fontcolor=darkgoldenrod];
T_NORMAL [label="NORMAL\nLo que observas puede ser normal. Sigue observando.", shape=doublecircle, color=green, fontcolor=darkgreen];

// FONTANELA
q_cab_gate_fontanela -> T_URGENCIA [label="Sí"];
q_cab_gate_fontanela -> q_cab_gate_ojos [label="No"];

// OJOS
q_cab_gate_ojos -> q_cab_ojos [label="Sí"];
q_cab_gate_ojos -> q_cab_gate_oidos [label="No"];
q_cab_ojos -> T_NORMAL [label="Ojos con lagañas pero no rojo/hinchado (1)"];
q_cab_ojos -> T_CONSULTA [label="Secreción repetida en ojo, sin hinchar (2)"];
q_cab_ojos -> T_URGENCIA [label="Pus en ojo e hinchado/rojo (3)"];

// OÍDOS
q_cab_gate_oidos -> q_cab_oidos [label="Sí"];
q_cab_gate_oidos -> T_NORMAL [label="No"];
q_cab_oidos -> T_URGENCIA [label="Pus o secreción amarilla/verdosa de oído (3)"];
q_cab_oidos -> T_URGENCIA [label="Sangre de oído (3)"];
q_cab_oidos -> T_CONSULTA [label="Líquido transparente del oído (no agua de baño) (2)"];
q_cab_oidos -> T_NORMAL [label="Cera amarilla/café normal o agua de baño (1)"];

}
