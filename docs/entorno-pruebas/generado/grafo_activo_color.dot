digraph grafo_activo_color {
// Generado desde grafo_activo_color.json — Evaluación de Actividad y Color
// Configuración general
graph [ranksep=1.5, nodesep=1.2];
node [fontname="Helvetica", style=filled, fillcolor=white, margin=0.2];
edge [fontname="Helvetica", fontsize=11, minlen=2];

// NODOS
q_neuro_gate [label="¿Nota cambios en la actividad, el llanto o el color de su bebé?", color=black];
q_neuro_areas [label="Marca todo lo que quieras revisar.", color=blue, fontcolor=blue];
q_neuro_tono [label="Marca todo lo que notes en su movimiento o tono.", color=blue, fontcolor=blue];
q_neuro_llanto [label="Marca todo lo que notes en su llanto.", color=blue, fontcolor=blue];
q_neuro_color [label="Marca todo lo que notes en su color.", color=blue, fontcolor=blue];
T_URGENCIA [label="URGENCIA\nLleva a tu bebé a urgencias ahora.", shape=doublecircle, color=red, fontcolor=red];
T_CONSULTA [label="CONSULTAR_MEDICO\nContacta hoy al Programa Madre Canguro.", shape=doublecircle, color=yellow, fontcolor=darkgoldenrod];
T_NORMAL [label="NORMAL\nLo que observas puede ser normal. Sigue observando.", shape=doublecircle, color=green, fontcolor=darkgreen];

// ARISTAS
q_neuro_gate -> q_neuro_areas [label="\n   Sí   \n"];
q_neuro_gate -> T_NORMAL [label="\n   No   \n"];
q_neuro_areas -> q_neuro_tono [label="\n   Movimiento y tono (3)   \n"];
q_neuro_areas -> q_neuro_llanto [label="\n   Llanto e irritabilidad (3)   \n"];
q_neuro_areas -> q_neuro_color [label="\n   Color de piel y ojos (3)   \n"];
q_neuro_tono -> T_URGENCIA [label="\n   Mucho más dormido / cuesta despertarlo (3)   \n"];
q_neuro_tono -> T_URGENCIA [label="\n   Más flojito de lo habitual (3)   \n"];
q_neuro_tono -> T_URGENCIA [label="\n   Más tieso de lo habitual / cuerpo rígido (3)   \n"];
q_neuro_tono -> T_URGENCIA [label="\n   Movimientos anormales o repetitivos (3)   \n"];
q_neuro_tono -> T_NORMAL [label="\n   Duerme bastante, pero despierta para comer y activo (1)   \n"];
q_neuro_tono -> T_NORMAL [label="\n   Sobresaltos mientras duerme y luego normal (1)   \n"];
q_neuro_llanto -> T_CONSULTA [label="\n   Más irritable/llora más, pero calma (2)   \n"];
q_neuro_llanto -> T_URGENCIA [label="\n   Llanto inconsolable (3)   \n"];
q_neuro_color -> T_NORMAL [label="\n   Solo blanco de ojos amarillo, comiendo y comportándose bien (1)   \n"];
q_neuro_color -> T_CONSULTA [label="\n   Color amarillo en ojos, cara o hasta pecho (2)   \n"];
q_neuro_color -> T_URGENCIA [label="\n   Amarillo por debajo del ombligo o piernas (3)   \n"];
q_neuro_color -> T_URGENCIA [label="\n   Palmas de manos o plantas amarillas (3)   \n"];
q_neuro_color -> T_URGENCIA [label="\n   Amarillo + muy dormido/no come (3)   \n"];
q_neuro_color -> T_URGENCIA [label="\n   Amarillo en primeras 24 horas (3)   \n"];
}
