digraph grafo_respiracion {
// Generado desde grafo_respiracion.json — Evaluación de Respiración y Nariz
// Configuración general
node [fontname="Helvetica", style=filled, fillcolor=white];
edge [fontname="Helvetica", fontsize=10];

// NODOS
q_resp_gate_vista [label="¿Notas que respira muy rápido, con esfuerzo, distinto o con un color raro?", color=black];
q_resp_gate_sonidos [label="¿Hace ruidos, tos o pausas al respirar?", color=black];
q_resp_gate_nariz [label="¿Tiene congestión, estornudos o hipo?", color=black];
q_resp_vista [label="Marca todo lo que veas.", color=blue, fontcolor=blue];
q_resp_sonidos [label="Marca todo lo que escuches.", color=blue, fontcolor=blue];
q_resp_nariz [label="Marca todo lo que notes.", color=blue, fontcolor=blue];
T_URGENCIA [label="URGENCIA\nLleva a tu bebé a urgencias ahora.", shape=doublecircle, color=red, fontcolor=red];
T_CONSULTA [label="CONSULTAR_MEDICO\nContacta hoy al Programa Madre Canguro.", shape=doublecircle, color=yellow, fontcolor=darkgoldenrod];
T_NORMAL [label="NORMAL\nLo que observas puede ser normal. Sigue observando.", shape=doublecircle, color=green, fontcolor=darkgreen];

// ARISTAS
q_resp_gate_vista -> q_resp_vista [label="\n   Sí   \n"];
q_resp_gate_vista -> q_resp_gate_sonidos [label="\n   No   \n"];
q_resp_vista -> T_URGENCIA [label="\n   Respira persistentemente rápido (≥60/min) (3)   \n"];
q_resp_vista -> T_URGENCIA [label="\n   Aleteo nasal (3)   \n"];
q_resp_vista -> T_URGENCIA [label="\n   Se le hunde el pecho (3)   \n"];
q_resp_vista -> T_URGENCIA [label="\n   Labios o cara azules/grises (3)   \n"];
q_resp_vista -> T_CONSULTA [label="\n   Respira diferente sin esfuerzo (2)   \n"];
q_resp_vista -> T_NORMAL [label="\n   A veces respira más rápido y luego normal (1)   \n"];
q_resp_vista -> T_NORMAL [label="\n   Manos o pies azulados, pero labios rosados (1)   \n"];
q_resp_gate_sonidos -> q_resp_sonidos [label="\n   Sí   \n"];
q_resp_gate_sonidos -> q_resp_gate_nariz [label="\n   No   \n"];
q_resp_sonidos -> T_URGENCIA [label="\n   Quejido al respirar (3)   \n"];
q_resp_sonidos -> T_URGENCIA [label="\n   Pausas o Apneas con cambio de color (3)   \n"];
q_resp_sonidos -> T_CONSULTA [label="\n   Ruido al respirar que antes no hacía (2)   \n"];
q_resp_sonidos -> T_CONSULTA [label="\n   Presenta tos pero respira tranquilo (2)   \n"];
q_resp_sonidos -> T_NORMAL [label="\n   Pausas cortas sin cambiar de color (1)   \n"];
q_resp_sonidos -> T_NORMAL [label="\n   Ruiditos pero respira tranquilo (1)   \n"];
q_resp_gate_nariz -> q_resp_nariz [label="\n   Sí   \n"];
q_resp_gate_nariz -> T_NORMAL [label="\n   No   \n"];
q_resp_nariz -> T_URGENCIA [label="\n   Congestión no permite alimentarse (3)   \n"];
q_resp_nariz -> T_URGENCIA [label="\n   Más respiración rápida, quejido, etc. (3)   \n"];
q_resp_nariz -> T_CONSULTA [label="\n   Congestión cuesta alimentar pero completa tomas (2)   \n"];
q_resp_nariz -> T_NORMAL [label="\n   Moquitos pero respira/come bien (1)   \n"];
q_resp_nariz -> T_NORMAL [label="\n   Estornuda de vez en cuando (1)   \n"];
q_resp_nariz -> T_NORMAL [label="\n   Tiene hipo (1)   \n"];
}
