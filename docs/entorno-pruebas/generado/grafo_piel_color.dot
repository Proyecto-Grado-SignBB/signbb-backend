digraph grafo_piel_color {
// Generado desde grafo_piel_color.json — Evaluación de Piel y Color
// Configuración general
graph [ranksep=1.5, nodesep=1.2];
node [fontname="Helvetica", style=filled, fillcolor=white, margin=0.2];
edge [fontname="Helvetica", fontsize=11, minlen=2];

// NODOS
q_piel_gate [label="¿Nota cambios en el color de la piel o los ojos de su bebé?", color=black];
q_piel_color [label="Marca todo lo que notes en su color.", color=blue, fontcolor=blue];
T_URGENCIA [label="URGENCIA\nLleva a tu bebé a urgencias ahora.", shape=doublecircle, color=red, fontcolor=red];
T_CONSULTA [label="CONSULTAR_MEDICO\nContacta hoy al Programa Madre Canguro.", shape=doublecircle, color=yellow, fontcolor=darkgoldenrod];
T_NORMAL [label="NORMAL\nLo que observas puede ser normal. Sigue observando.", shape=doublecircle, color=green, fontcolor=darkgreen];

// ARISTAS
q_piel_gate -> q_piel_color [label="\n   Sí   \n"];
q_piel_gate -> T_NORMAL [label="\n   No   \n"];
q_piel_color -> T_NORMAL [label="\n   Solo blanco de ojos amarillo, comiendo y comportándose bien (1)   \n"];
q_piel_color -> T_CONSULTA [label="\n   Color amarillo en ojos, cara o hasta pecho (2)   \n"];
q_piel_color -> T_URGENCIA [label="\n   Amarillo por debajo del ombligo o piernas (3)   \n"];
q_piel_color -> T_URGENCIA [label="\n   Palmas de manos o plantas amarillas (3)   \n"];
q_piel_color -> T_URGENCIA [label="\n   Amarillo + muy dormido/no come (3)   \n"];
q_piel_color -> T_URGENCIA [label="\n   Amarillo en primeras 24 horas (3)   \n"];
}
